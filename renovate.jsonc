{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // https://github.com/homeassistant-apps/app-cloudflared/blob/main/.github/renovate.json
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies", "no-stale"],
  "commitMessagePrefix": "⬆️",
  //"commitMessageTopic": "{{depName}}",

  // https://github.com/renovatebot/renovate/discussions/40077#discussioncomment-15300800
  "registryAliases": {
    "dhi.io": "dhi.io"
  },

  "packageRules": [
    {
      "description": "Docker: Gradle: Pin to JDK21, Alpine 3.24 dev images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/gradle"],

      "groupName": "gradle",

      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d)-jdk21-alpine3.24-dev$"
    },
    {
      "matchDatasources": ["gradle-version"],

      "groupName": "gradle"
    },
    {
      "description": "Docker: Curl: Pin to dev images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/curl"],

      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-dev$"
    },
    {
      "description": "Docker: Bun: Pin to dev images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/bun"],

      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine3.22-dev$"
    },
    {
      "description": "Docker: Eclipse-Temurin: Pin to JRE Alpine 3.23 dev images. No major updates.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/eclipse-temurin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-alpine3.23-dev$",
      
      "allowedVersions": "/^21.+$/"
    },
    {
      "description": "Docker: Node: Pin to runtime images.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/node"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine3.23$"
            
      // "allowedVersions": "/^24.+$/"
    }
  ]
}
