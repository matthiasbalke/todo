{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // use conventional commits
    ":semanticCommits",
    // always update kotlin Gradle plugins at the same time, in one PR branch
    "group:kotlinMonorepo",
    // support for apk versioning annotations
    "customManagers:dockerfileVersions",
    // support for _VERSION variables in GitHub Actions workflow/action YAML files
    "customManagers:githubActionsVersions"
  ],

  "customDatasources": {
//    "alpine": {
//      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/",
//      "format": "html"
//    },
    "alpine3_23": {
      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/",
      "format": "html"
    },
    "alpine3_24": {
      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/",
      "format": "html"
    }
},

  "customManagers": [
//    {
//      "customType": "regex",
//      "managerFilePatterns": [
//        "//Dockerfile$/"
//      ],
//      "matchStringsStrategy": "any",
//      "matchStrings": [
//        //"\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)="(?<currentValue>[a-z0-9-_.]+)"\\s+"
//        "ARG\\s+(?<package>[a-zA-Z0-9][a-zA-Z0-9-_]+)_VERSION=\"(?<currentValue>[a-z0-9-_.]+)\"\\s+"
//      ],
//      "versioningTemplate": "loose",
//      "datasourceTemplate": "custom.alpine",
//      "depNameTemplate": "alpine_3_24/{{package}}",
//      "extractVersionTemplate": "^{{{package}}}-(?<version>\\d.*)\\.apk$"
//    },
    {
      "customType": "regex",
      "description": "Update _VERSION ENV and ARG variables in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    }
  ],

  // https://github.com/homeassistant-apps/app-cloudflared/blob/main/.github/renovate.json
  // rebasing is required to merge PRs into main
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  // label dependency updates nicely
  "labels": ["dependencies", "no-stale"],

  // https://github.com/renovatebot/renovate/discussions/40077#discussioncomment-15300800
  "registryAliases": {
    "dhi.io": "dhi.io"
  },    

  "packageRules": [
//    {
//      "description": "Packages that live in the Alpine community repository",
//      "matchDatasources": ["custom.alpine3_24"],
//      "matchPackageNames": [],
//      "registryUrls": [
//        "https://dl-cdn.alpinelinux.org/alpine/v3.24/community/x86_64/"
//      ]
//    },

    {
      "matchDatasources": ["gradle-version"],

      // always update Gradle wrapper together with the Gradle build image
      "groupName": "gradle"
    },
    // -------------------------------------------------------------------------
    // DHI: Gradle
    //
    // Only use the Java 21 / Alpine 3.24 development variant.
    //
    // Examples:
    //   9.6.1-r6-jdk21-alpine3.24-dev
    //   9.6.1-r7-jdk21-alpine3.24-dev   <- build
    //   9.6.2-r1-jdk21-alpine3.24-dev   <- patch
    //   9.7.0-r1-jdk21-alpine3.24-dev   <- minor
    //
    // Java and Alpine versions are part of "compatibility" and therefore
    // Renovate will never switch them.
    // -------------------------------------------------------------------------
    {
      "description": "DHI Gradle: Java 21 / Alpine 3.24 dev only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/gradle"
      ],

      // always update Gradle wrapper together with the Gradle build image
      "groupName": "gradle",

      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-(?<compatibility>jdk21-alpine3\\.24-dev)$"
    },

    // -------------------------------------------------------------------------
    // DHI: curl
    //
    // Only development images ending in "-dev".
    //
    // Examples:
    //   8-dev
    //   8.21-dev
    //   8.21.0-dev
    // -------------------------------------------------------------------------
    {
      "description": "DHI curl: dev images only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/curl"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?-(?<compatibility>[^-]*-dev)$"
    },

    // -------------------------------------------------------------------------
    // DHI: PostgreSQL
    //
    // Only Alpine 3.24 runtime images.
    //
    // Examples:
    //   17.11-alpine3.24
    //   17.12-alpine3.24   <- minor
    //   18.0-alpine3.24    <- major
    //
    // Alpine 3.24 is part of "compatibility" and therefore Renovate will never
    // switch to a different Alpine variant.
    // -------------------------------------------------------------------------
    {
      "description": "DHI PostgreSQL: Alpine 3.24 runtime only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/postgres"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>alpine3\\.24)$"
    },

    // -------------------------------------------------------------------------
    // DHI: Eclipse Temurin
    //
    // Only Alpine 3.23 development images.
    //
    // Eclipse Temurin has an additional build number in some tags:
    //
    //   21-alpine3.23-dev
    //   21.0-alpine3.23-dev
    //   21.0.11-alpine3.23-dev
    //   21.0.11.10-alpine3.23-dev
    //
    // The fourth numeric component is therefore treated as "build".
    // -------------------------------------------------------------------------
    {
      "description": "DHI Eclipse Temurin: Alpine 3.23 dev only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/eclipse-temurin"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))-(?<compatibility>alpine3\\.23-dev)$"
    },

    // -------------------------------------------------------------------------
    // DHI: Node.js
    //
    // Only Alpine 3.23 runtime images.
    //
    // Examples:
    //   24-alpine3.23
    //   24.17-alpine3.23
    //   24.17.0-alpine3.23
    // -------------------------------------------------------------------------
    {
      "description": "DHI Node: Alpine 3.23 runtime only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/node"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))-(?<compatibility>alpine3\\.23)$"
    },

    // -------------------------------------------------------------------------
    // DHI: Bun
    //
    // Only development images containing "alpine" in the compatibility part.
    //
    // Examples:
    //   1-alpine-dev
    //   1.3-alpine-dev
    //   1.3.14-alpine3.22-dev
    // -------------------------------------------------------------------------
    {
      "description": "DHI Bun: Alpine dev images only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/bun"
      ],
      "versioning": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))-(?<compatibility>.*alpine.*-dev)$"
    },

    // -------------------------------------------------------------------------
    // All DHI images above:
    //
    // Allow minor, patch and build updates, but never major updates.
    // This rule intentionally contains all images so the policy doesn't have
    // to be repeated in every individual image rule.
    // -------------------------------------------------------------------------
    {
      "description": "DHI images: disable major updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        // stay on JDK 21 for Kotlin compatibility
        "dhi.io/eclipse-temurin",
        // stay on Node 24 until further tested
        "dhi.io/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}

