# Copy to .env.dev and set the hostname covered by .certs/cert.pem.
LOCAL_HTTPS_DOMAIN=todo.example.com
DEV_PROXY_PORT=443
DEV_FRONTEND_PORT=5173
DEV_BACKEND_PORT=8080
DEV_MAILPIT_PORT=8025
# Optional on Docker Desktop when Vite misses filesystem events.
DEV_FRONTEND_POLLING=false
# Used only when initializing an empty development database.
SETUP_SECRET=local-dev-setup-secret
